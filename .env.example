# URL publique du serveur (sans / final)
PUBLIC_URL=https://mcp.exemple.fr

EWS_URL=https://ex2.mail.ovh.net/EWS/Exchange.asmx
EWS_DOMAIN=

# Domaines email autorisés à se connecter, séparés par des virgules
ALLOWED_DOMAINS=exemple.fr

# Clé de chiffrement des mots de passe (32 octets en base64) : openssl rand -base64 32
# Ne jamais la changer après la mise en service : les mots de passe stockés deviendraient illisibles.
ENCRYPTION_KEY=

# Optionnel — callbacks OAuth autorisés (défaut: claude.ai et claude.com)
# ALLOWED_REDIRECT_URIS=https://claude.ai/api/mcp/auth_callback,https://claude.com/api/mcp/auth_callback
# PORT=3000
# DATA_DIR=./data

# Uniquement pour test-manual.js
EWS_USERNAME=
EWS_PASSWORD=
